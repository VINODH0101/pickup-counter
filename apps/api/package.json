{
  "name": "@pickup-counter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:concurrency": "vitest run tests/required-concurrency.integration.test.ts",
    "migrate": "tsx src/db/run-migrate.ts",
    "seed": "tsx src/db/run-seed.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "verify:stage5": "tsx scripts/verify-stage-5.ts",
    "verify:stage7": "tsx scripts/verify-stage-7.ts",
    "verify:e2e": "tsx scripts/verify-e2e-flow.ts",
    "verify:fresh-start": "tsx scripts/verify-fresh-start.ts",
    "send-webhook": "tsx src/scripts/send-webhook.ts",
    "webhook:send": "tsx src/scripts/send-webhook.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
