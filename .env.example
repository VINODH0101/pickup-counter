# ==============================================================================
# Pickup Counter Environment Configuration Template
# Copy to .env for local Docker Compose or development use.
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

POSTGRES_DB=pickup_counter
POSTGRES_USER=pickup_user
POSTGRES_PASSWORD=replace_for_local_development

# Database connection URL for Docker Compose (uses internal service hostname 'db')
DATABASE_URL=postgresql://pickup_user:replace_for_local_development@db:5432/pickup_counter

# Webhook Secrets
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Port configuration
API_PORT=3001
WEB_PORT=5173
POSTGRES_PORT=5432

# Connection string for local host development (outside Docker container)
# LOCAL_DATABASE_URL=postgresql://pickup:pickup@localhost:5432/pickup_counter
# TEST_DATABASE_URL=postgresql://pickup:pickup@localhost:5432/pickup_counter_test
